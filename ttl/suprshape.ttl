@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .

<https://suprduprnatural.github.io/supr-pedals/shape> a lv2:Plugin, lv2:EQPlugin ; doap:name "SuprShape" ; doap:license <https://opensource.org/licenses/MIT> ; lv2:minorVersion 1 ; lv2:microVersion 0 ; lv2:optionalFeature lv2:hardRTCapable ;
    rdfs:comment "Neutral clean EQ. HPF zero and LPF 20000 bypass their filters. Optional input-keyed dynamic bells only cut; no makeup gain or unconditional DC blocker. Leave headroom for boosts." ;
    lv2:port [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In" ],
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out" ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 2 ; lv2:symbol "hpf" ; lv2:name "HPF" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ; units:unit units:hz ; lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 3 ; lv2:symbol "lpf" ; lv2:name "LPF" ; lv2:default 20000 ; lv2:minimum 1000 ; lv2:maximum 20000 ; units:unit units:hz ; lv2:scalePoint [ rdfs:label "Off" ; rdf:value 20000 ] ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "bass" ; lv2:name "Bass" ; lv2:default 0 ; lv2:minimum -12 ; lv2:maximum 12 ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "treble" ; lv2:name "Treble" ; lv2:default 0 ; lv2:minimum -12 ; lv2:maximum 12 ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "mid_freq" ; lv2:name "Mid Hz" ; lv2:default 700 ; lv2:minimum 150 ; lv2:maximum 4000 ; units:unit units:hz ; lv2:portProperty pprops:logarithmic ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "mid_gain" ; lv2:name "Mid gain" ; lv2:default 0 ; lv2:minimum -12 ; lv2:maximum 12 ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "mid_q" ; lv2:name "Mid Q" ; lv2:default 1 ; lv2:minimum 0.3 ; lv2:maximum 4 ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 9 ; lv2:symbol "level" ; lv2:name "Level" ; lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 6 ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 10 ; lv2:symbol "boom" ; lv2:name "Boom cut" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 12 ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 11 ; lv2:symbol "boom_freq" ; lv2:name "Boom Hz" ; lv2:default 120 ; lv2:minimum 50 ; lv2:maximum 350 ; units:unit units:hz ; lv2:portProperty pprops:logarithmic ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 12 ; lv2:symbol "harsh" ; lv2:name "Harsh cut" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 12 ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 13 ; lv2:symbol "harsh_freq" ; lv2:name "Harsh Hz" ; lv2:default 2500 ; lv2:minimum 800 ; lv2:maximum 6000 ; units:unit units:hz ; lv2:portProperty pprops:logarithmic ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 14 ; lv2:symbol "threshold" ; lv2:name "Threshold" ; lv2:default -30 ; lv2:minimum -60 ; lv2:maximum 0 ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 15 ; lv2:symbol "release" ; lv2:name "Release" ; lv2:default 250 ; lv2:minimum 50 ; lv2:maximum 1000 ; units:unit units:ms ; lv2:portProperty pprops:logarithmic ],
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 16 ; lv2:symbol "boom_gr" ; lv2:name "boom_gr" ; lv2:minimum -12 ; lv2:maximum 0 ; units:unit units:db ; lv2:portProperty pprops:notOnGUI ],
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 17 ; lv2:symbol "harsh_gr" ; lv2:name "harsh_gr" ; lv2:minimum -12 ; lv2:maximum 0 ; units:unit units:db ; lv2:portProperty pprops:notOnGUI ] .
