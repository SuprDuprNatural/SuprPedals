@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://suprduprnatural.github.io/supr-pedals/echo> a lv2:Plugin, lv2:DelayPlugin ;
    doap:name "SuprEcho" ; doap:license <https://opensource.org/licenses/MIT> ;
    lv2:minorVersion 1 ; lv2:microVersion 0 ; lv2:optionalFeature lv2:hardRTCapable ;
    rdfs:comment "Mono filtered ducking echo. Dry remains unity and undelayed; Mix adds wet. Send off preserves trails; host bypass does not. Hold in Echo is bounded repeat extension, not infinite freeze." ;
    lv2:port [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In" ],
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out" ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 2 ; lv2:symbol "time" ; lv2:name "Time" ; lv2:default 375 ; lv2:minimum 20 ; lv2:maximum 2000 ; units:unit units:ms ; rdfs:comment "Quarter-note period in ms; PiPedal MIDI Tap Tempo maps here. Division scales this period. Changes crossfade stationary taps over 20 ms." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 3 ; lv2:symbol "feedback" ; lv2:name "Feedback" ; lv2:default 0.4 ; lv2:minimum 0 ; lv2:maximum 0.92 ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:default 0.2 ; lv2:minimum 0 ; lv2:maximum 1 ; rdfs:comment "Additive wet level. Dry stays unity; zero is exact dry." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "duck" ; lv2:name "Duck" ; lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1 ; rdfs:comment "Clean-input return ducking; never changes the feedback network." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "tone" ; lv2:name "Tone" ; lv2:default 3500 ; lv2:minimum 800 ; lv2:maximum 12000 ; units:unit units:hz ; lv2:portProperty pprops:logarithmic ; rdfs:comment "Low-pass cutoff within the feedback network." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "lowcut" ; lv2:name "Low cut" ; lv2:default 150 ; lv2:minimum 40 ; lv2:maximum 600 ; units:unit units:hz ; lv2:portProperty pprops:logarithmic ; rdfs:comment "Two-pole high-pass on wet send; dry bass remains untouched." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "recovery" ; lv2:name "Recovery" ; lv2:default 300 ; lv2:minimum 50 ; lv2:maximum 1500 ; units:unit units:ms ; rdfs:comment "Clean-input detector release time constant in milliseconds." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 9 ; lv2:symbol "division" ; lv2:name "Division" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:portProperty lv2:enumeration, lv2:integer ; lv2:scalePoint [ rdfs:label "Quarter" ; rdf:value 0 ] ; lv2:scalePoint [ rdfs:label "Eighth" ; rdf:value 1 ] ; lv2:scalePoint [ rdfs:label "Dotted eighth" ; rdf:value 2 ] ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 10 ; lv2:symbol "send" ; lv2:name "Send" ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, lv2:integer ; rdfs:comment "Off stops new wet input with a 10 ms fade and leaves existing tails audible. Keep the plugin enabled in the host to hear trails." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 11 ; lv2:symbol "hold" ; lv2:name "Hold" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, lv2:integer ; rdfs:comment "Momentary repeat extension: closes send and raises feedback to 0.995, with filtering and a ten-second timeout. Release to rearm. Not infinite freeze." ],
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 12 ; lv2:symbol "duck_gr" ; lv2:name "Duck reduction" ; lv2:minimum -120 ; lv2:maximum 0 ; units:unit units:db ; lv2:portProperty pprops:notOnGUI ] .
