@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix param:  <http://lv2plug.in/ns/ext/parameters#> .
@prefix pg:     <http://lv2plug.in/ns/ext/port-groups#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

@prefix band: <https://suprduprnatural.github.io/supr-pedals/multiband#> .

# Five groups: the split, three identical band strips, and the master.
band:crossoverGroup
    a param:ControlGroup , pg:InputGroup ;
    lv2:name "Crossover" ;
    lv2:symbol "crossoverGroup" .

band:lowGroup
    a param:ControlGroup , pg:InputGroup ;
    lv2:name "Low" ;
    lv2:symbol "lowGroup" .

band:midGroup
    a param:ControlGroup , pg:InputGroup ;
    lv2:name "Mid" ;
    lv2:symbol "midGroup" .

band:highGroup
    a param:ControlGroup , pg:InputGroup ;
    lv2:name "High" ;
    lv2:symbol "highGroup" .

band:outputGroup
    a param:ControlGroup , pg:InputGroup ;
    lv2:name "Output" ;
    lv2:symbol "outputGroup" .

<https://suprduprnatural.github.io/supr-pedals/multiband>
    a lv2:Plugin , lv2:CompressorPlugin ;
    doap:name "SuprBand" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    mod:brand "Supr" ;
    mod:label "SuprBand" ;
    rdfs:comment "Multiband processor for bass: keep the fundamental clean and drive, compress or trim only what sits above it. Three Linkwitz-Riley bands with the low one phase-matched to the pair above it, so the bands sum flat instead of combing where a bass lives. Per-band drive, one-knob compression with time constants set by the band's own frequency, and level. Starts transparent." ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "split1" ;
        lv2:name "Low Split" ;
        pg:group band:crossoverGroup ;
        lv2:default 150.0 ;
        lv2:minimum 40.0 ;
        lv2:maximum 500.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:hz ;
        rdfs:comment "Put this above the fundamental of your lowest note to keep it out of the bands above." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "split2" ;
        lv2:name "High Split" ;
        pg:group band:crossoverGroup ;
        lv2:default 1200.0 ;
        lv2:minimum 400.0 ;
        lv2:maximum 5000.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "lowDrive" ;
        lv2:name "Drive" ;
        pg:group band:lowGroup ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
        rdfs:comment "0 is an exact bypass. Peaks stay where they are as this comes up; quiet playing rises." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "lowComp" ;
        lv2:name "Comp" ;
        pg:group band:lowGroup ;
        lv2:default 0.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 0.0 ;
        units:unit units:db ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0.0 ] ;
        rdfs:comment "Threshold, and it firms the ratio as it descends (2:1 to 8:1). Attack and release come from the band's own frequency. Watch the meter." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "lowLevel" ;
        lv2:name "Level" ;
        pg:group band:lowGroup ;
        lv2:default 0.0 ;
        lv2:minimum -30.0 ;
        lv2:maximum 12.0 ;
        pprops:rangeSteps 15 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "midDrive" ;
        lv2:name "Drive" ;
        pg:group band:midGroup ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "midComp" ;
        lv2:name "Comp" ;
        pg:group band:midGroup ;
        lv2:default 0.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 0.0 ;
        units:unit units:db ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0.0 ] ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "midLevel" ;
        lv2:name "Level" ;
        pg:group band:midGroup ;
        lv2:default 0.0 ;
        lv2:minimum -30.0 ;
        lv2:maximum 12.0 ;
        pprops:rangeSteps 15 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "highDrive" ;
        lv2:name "Drive" ;
        pg:group band:highGroup ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "highComp" ;
        lv2:name "Comp" ;
        pg:group band:highGroup ;
        lv2:default 0.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 0.0 ;
        units:unit units:db ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0.0 ] ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "highLevel" ;
        lv2:name "Level" ;
        pg:group band:highGroup ;
        lv2:default 0.0 ;
        lv2:minimum -30.0 ;
        lv2:maximum 12.0 ;
        pprops:rangeSteps 15 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 13 ;
        lv2:symbol "blend" ;
        lv2:name "Blend" ;
        pg:group band:outputGroup ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Clean to processed within the matched crossover path. All blends share crossover phase and 15-sample oversampling delay; Blend 0 is magnitude-flat, not a pure delayed bypass." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 14 ;
        lv2:symbol "level" ;
        lv2:name "Level" ;
        pg:group band:outputGroup ;
        lv2:default 0.0 ;
        lv2:minimum -30.0 ;
        lv2:maximum 12.0 ;
        pprops:rangeSteps 15 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 15 ;
        lv2:symbol "grLow" ;
        lv2:name "Low GR" ;
        lv2:default 0.0 ;
        lv2:minimum -30.0 ;
        lv2:maximum 0.0 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 16 ;
        lv2:symbol "grMid" ;
        lv2:name "Mid GR" ;
        lv2:default 0.0 ;
        lv2:minimum -30.0 ;
        lv2:maximum 0.0 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 17 ;
        lv2:symbol "grHigh" ;
        lv2:name "High GR" ;
        lv2:default 0.0 ;
        lv2:minimum -30.0 ;
        lv2:maximum 0.0 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 18 ;
        lv2:symbol "latency" ;
        lv2:name "Latency" ;
        lv2:designation lv2:latency ;
        lv2:default 15 ;
        lv2:minimum 0 ;
        lv2:maximum 64 ;
        lv2:portProperty pprops:notOnGUI , lv2:reportsLatency , lv2:integer ;
        units:unit units:frame ;
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 19 ;
        lv2:symbol "drvLow" ;
        lv2:name "Low Drive Action" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 24.0 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:db ;
        rdfs:comment "How much level the drive stage is adding to this band right now — program dependent, and the rise the band's Level is used to put back. 0 when Drive is 0." ;
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 20 ;
        lv2:symbol "drvMid" ;
        lv2:name "Mid Drive Action" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 24.0 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 21 ;
        lv2:symbol "drvHigh" ;
        lv2:name "High Drive Action" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 24.0 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:db ;
    ] .
