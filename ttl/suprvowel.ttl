@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .

# Relative semitone offset: PiPedal renders the standard semitone12TET unit
# as an absolute note name. A custom unit keeps Throat numeric in every view.
<https://suprduprnatural.github.io/supr-pedals/vowel#semitone-offset>
    a units:Unit ; rdfs:label "semitones" ; units:symbol "st" ; units:render "%f st" .

<https://suprduprnatural.github.io/supr-pedals/vowel> a lv2:Plugin, lv2:FilterPlugin ;
    doap:name "SuprVowel" ; doap:license <https://opensource.org/licenses/MIT> ;
    lv2:minorVersion 1 ; lv2:microVersion 0 ; lv2:optionalFeature lv2:hardRTCapable ;
    rdfs:comment "Expressive mono bass formant filter. Three resonances morph between five vowels using manual/expression, envelope or free-running LFO motion. Protected low end; no pitch tracking or added transport latency." ;
    lv2:port [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In" ],
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out" ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 2 ; lv2:symbol "vowel_a" ; lv2:name "From" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:scalePoint [ rdfs:label "OO" ; rdf:value 0 ], [ rdfs:label "OH" ; rdf:value 1 ], [ rdfs:label "AH" ; rdf:value 2 ], [ rdfs:label "EH" ; rdf:value 3 ], [ rdfs:label "EE" ; rdf:value 4 ] ; rdfs:comment "Resting vowel. Swap From and To to reverse the motion." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 3 ; lv2:symbol "vowel_b" ; lv2:name "To" ; lv2:default 2 ; lv2:minimum 0 ; lv2:maximum 4 ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:scalePoint [ rdfs:label "OO" ; rdf:value 0 ], [ rdfs:label "OH" ; rdf:value 1 ], [ rdfs:label "AH" ; rdf:value 2 ], [ rdfs:label "EH" ; rdf:value 3 ], [ rdfs:label "EE" ; rdf:value 4 ] ; rdfs:comment "Destination vowel." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "mode" ; lv2:name "Motion" ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:scalePoint [ rdfs:label "Manual" ; rdf:value 0 ], [ rdfs:label "Envelope" ; rdf:value 1 ], [ rdfs:label "LFO" ; rdf:value 2 ] ; rdfs:comment "Manual uses Position directly; Envelope and LFO add Depth above Position." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "position" ; lv2:name "Position" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; rdfs:comment "Manual vowel position or modulation floor. Map an expression pedal here in Manual mode." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "depth" ; lv2:name "Depth" ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ; rdfs:comment "Envelope/LFO travel above Position, capped at the destination." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "rate" ; lv2:name "Rate" ; lv2:default 1 ; lv2:minimum 0.05 ; lv2:maximum 8 ; units:unit units:hz ; lv2:portProperty pprops:logarithmic ; rdfs:comment "Free-running LFO rate. Not host-tempo synchronized." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "sensitivity" ; lv2:name "Sensitivity" ; lv2:default 6 ; lv2:minimum -24 ; lv2:maximum 24 ; units:unit units:db ; rdfs:comment "Envelope detector gain only. Adjust until normal playing uses the desired vowel travel." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 9 ; lv2:symbol "release" ; lv2:name "Release" ; lv2:default 180 ; lv2:minimum 40 ; lv2:maximum 800 ; units:unit units:ms ; lv2:portProperty pprops:logarithmic ; rdfs:comment "Envelope recovery. Attack is fixed at 5 ms; the vowel motion is additionally smoothed." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 10 ; lv2:symbol "throat" ; lv2:name "Throat" ; lv2:default 0 ; lv2:minimum -6 ; lv2:maximum 6 ; units:unit <https://suprduprnatural.github.io/supr-pedals/vowel#semitone-offset> ; rdfs:comment "Shifts all formants together without changing the pitch of the played note." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 11 ; lv2:symbol "focus" ; lv2:name "Focus" ; lv2:default 0.6 ; lv2:minimum 0 ; lv2:maximum 1 ; rdfs:comment "Formant sharpness; peak-normalized resonances do not grow with Focus." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 12 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:default 0.8 ; lv2:minimum 0 ; lv2:maximum 1 ; rdfs:comment "Dry to bass-protected vowel voice. Zero is exact dry at unity Level." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 13 ; lv2:symbol "level" ; lv2:name "Level" ; lv2:default 0 ; lv2:minimum -12 ; lv2:maximum 12 ; units:unit units:db ; rdfs:comment "Output trim after the dry/wet mix." ],
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 14 ; lv2:symbol "morph" ; lv2:name "Vowel position" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty pprops:notOnGUI ],
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 15 ; lv2:symbol "f1" ; lv2:name "First formant" ; lv2:default 350 ; lv2:minimum 80 ; lv2:maximum 6000 ; units:unit units:hz ; lv2:portProperty pprops:notOnGUI ],
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 16 ; lv2:symbol "f2" ; lv2:name "Second formant" ; lv2:default 600 ; lv2:minimum 80 ; lv2:maximum 6000 ; units:unit units:hz ; lv2:portProperty pprops:notOnGUI ],
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 17 ; lv2:symbol "f3" ; lv2:name "Third formant" ; lv2:default 2400 ; lv2:minimum 80 ; lv2:maximum 6000 ; units:unit units:hz ; lv2:portProperty pprops:notOnGUI ] .
