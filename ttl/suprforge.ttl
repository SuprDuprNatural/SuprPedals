@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix mod: <http://moddevices.com/ns/mod#> .
@prefix pg: <http://lv2plug.in/ns/ext/port-groups#> .
@prefix param: <http://lv2plug.in/ns/ext/parameters#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix forge: <https://suprduprnatural.github.io/supr-pedals/forge#> .

forge:drive a param:ControlGroup, pg:InputGroup ; lv2:name "Drive" ; lv2:symbol "drive" .
forge:foundation a param:ControlGroup, pg:InputGroup ; lv2:name "Foundation" ; lv2:symbol "foundation" .
forge:voice a param:ControlGroup, pg:InputGroup ; lv2:name "Voice" ; lv2:symbol "voice" .
forge:output a param:ControlGroup, pg:InputGroup ; lv2:name "Output" ; lv2:symbol "output" .

<https://suprduprnatural.github.io/supr-pedals/forge>
    a lv2:Plugin, lv2:DistortionPlugin ;
    doap:name "SuprForge" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    lv2:minorVersion 1 ; lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    mod:brand "Supr" ; mod:label "SuprForge" ;
    rdfs:comment "Modern bass distortion: clean compressed weight below Tight, two-stage saturation above it, independent Bite and Fizz, and a clean-input-keyed high-band gate. The entire crossover uses one 4x oversampling round trip with antiderivative antialiasing, with no unmatched global dry blend. Original voicing, not a model of a particular hardware pedal. Fixed 23-sample latency." ;
    lv2:port [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In" ] ,
             [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out" ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 2 ; lv2:symbol "drive" ; lv2:name "Drive" ;
        pg:group forge:drive ;
        lv2:default 6.5 ; lv2:minimum 0 ; lv2:maximum 10 ;
        rdfs:comment "Two-stage saturation above Tight. Zero removes the distortion; the clean low band stays independent."
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 3 ; lv2:symbol "weight" ; lv2:name "Weight" ;
        pg:group forge:foundation ;
        lv2:default 0 ; lv2:minimum -12 ; lv2:maximum 12 ;
        units:unit units:db ;
        rdfs:comment "Level of the clean low band. Adds weight without driving the clipping stages harder."
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "tight" ; lv2:name "Tight" ;
        pg:group forge:foundation ;
        lv2:default 180 ; lv2:minimum 80 ; lv2:maximum 500 ;
        units:unit units:hz ;
        lv2:portProperty pprops:logarithmic ;
        rdfs:comment "Crossover between clean compressed lows and distortion. Higher is tighter; lower is thicker."
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ; lv2:symbol "bite" ; lv2:name "Bite" ;
        pg:group forge:voice ;
        lv2:default 3 ; lv2:minimum -9 ; lv2:maximum 9 ;
        units:unit units:db ;
        rdfs:comment "Upper-mid bell at 1.8 kHz after distortion. Adds pick definition independently of the top-end cutoff."
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ; lv2:symbol "fizz" ; lv2:name "Fizz" ;
        pg:group forge:voice ;
        lv2:default 5000 ; lv2:minimum 1500 ; lv2:maximum 12000 ;
        units:unit units:hz ;
        lv2:portProperty pprops:logarithmic ;
        lv2:scalePoint [ rdfs:label "Open" ; rdf:value 12000 ] ;
        rdfs:comment "Four-pole high cut after the bands are summed. Lower removes more fizz. At 12 kHz the filter is bypassed (Open)."
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ; lv2:symbol "level" ; lv2:name "Level" ;
        pg:group forge:output ;
        lv2:default -3 ; lv2:minimum -24 ; lv2:maximum 12 ;
        units:unit units:db ;
        rdfs:comment "Final output trim. Match loudness before judging drive settings."
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 8 ; lv2:symbol "comp" ; lv2:name "Comp" ;
        pg:group forge:foundation ;
        lv2:default 3 ; lv2:minimum 0 ; lv2:maximum 10 ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ;
        rdfs:comment "Clean low-band compression, with a held-peak detector and bass-friendly timing. Zero is off; use Weight for makeup."
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 9 ; lv2:symbol "gate" ; lv2:name "Gate" ;
        pg:group forge:output ;
        lv2:default -65 ; lv2:minimum -90 ; lv2:maximum -30 ;
        units:unit units:db ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value -90 ] ;
        rdfs:comment "High-band gate keyed by the clean bass input. Leaves the low band alone. Lower for longer decays; -90 is Off."
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 10 ; lv2:symbol "low_gr" ; lv2:name "Low reduction" ;
        lv2:minimum -60 ; lv2:maximum 0 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:db
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 11 ; lv2:symbol "gate_gr" ; lv2:name "Gate reduction" ;
        lv2:minimum -120 ; lv2:maximum 0 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:db
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 12 ; lv2:symbol "peak" ; lv2:name "Output peak" ;
        lv2:minimum -120 ; lv2:maximum 36 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:db
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 13 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:minimum 23 ; lv2:maximum 23 ;
        lv2:portProperty pprops:notOnGUI ;
        lv2:designation lv2:latency ; units:unit units:frame
    ] .
