@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://suprduprnatural.github.io/supr-pedals/space> a lv2:Plugin, lv2:ReverbPlugin ;
    doap:name "SuprSpace" ; doap:license <https://opensource.org/licenses/MIT> ;
    lv2:minorVersion 1 ; lv2:microVersion 0 ; lv2:optionalFeature lv2:hardRTCapable ;
    rdfs:comment "Mono filtered ducking space. Dry remains unity and undelayed; Mix adds wet. Send off preserves trails; host bypass does not. Hold in Echo is bounded repeat extension, not infinite freeze." ;
    lv2:port [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In" ],
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out" ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 2 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:default 0.18 ; lv2:minimum 0 ; lv2:maximum 1 ; rdfs:comment "Additive wet level. Dry stays unity; zero is exact dry." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 3 ; lv2:symbol "decay" ; lv2:name "Decay" ; lv2:default 1.4 ; lv2:minimum 0.2 ; lv2:maximum 8 ; units:unit units:s ; lv2:portProperty pprops:logarithmic ; rdfs:comment "Nominal broadband RT60 in seconds; damping shortens high-frequency decay." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "tone" ; lv2:name "Tone" ; lv2:default 4500 ; lv2:minimum 800 ; lv2:maximum 12000 ; units:unit units:hz ; lv2:portProperty pprops:logarithmic ; rdfs:comment "Low-pass cutoff within the feedback network." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "duck" ; lv2:name "Duck" ; lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1 ; rdfs:comment "Clean-input return ducking; never changes the feedback network." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "predelay" ; lv2:name "Predelay" ; lv2:default 15 ; lv2:minimum 0 ; lv2:maximum 150 ; units:unit units:ms ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "lowcut" ; lv2:name "Low cut" ; lv2:default 180 ; lv2:minimum 40 ; lv2:maximum 600 ; units:unit units:hz ; lv2:portProperty pprops:logarithmic ; rdfs:comment "Two-pole high-pass on wet send; dry bass remains untouched." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "recovery" ; lv2:name "Recovery" ; lv2:default 350 ; lv2:minimum 50 ; lv2:maximum 1500 ; units:unit units:ms ; rdfs:comment "Clean-input detector release time constant in milliseconds." ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 9 ; lv2:symbol "send" ; lv2:name "Send" ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled, lv2:integer ; rdfs:comment "Off stops new wet input with a 10 ms fade and leaves existing tails audible. Keep the plugin enabled in the host to hear trails." ],
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 10 ; lv2:symbol "duck_gr" ; lv2:name "Duck reduction" ; lv2:minimum -120 ; lv2:maximum 0 ; units:unit units:db ; lv2:portProperty pprops:notOnGUI ] .
