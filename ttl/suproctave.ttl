@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix param:  <http://lv2plug.in/ns/ext/parameters#> .
@prefix pg:     <http://lv2plug.in/ns/ext/port-groups#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

@prefix oc: <https://suprduprnatural.github.io/supr-pedals/octave#> .

oc:mixGroup
    a param:ControlGroup , pg:InputGroup ;
    lv2:name "Mix" ;
    lv2:symbol "mixGroup" .

oc:subGroup
    a param:ControlGroup , pg:InputGroup ;
    lv2:name "Sub" ;
    lv2:symbol "subGroup" .

oc:filterGroup
    a param:ControlGroup , pg:InputGroup ;
    lv2:name "Filters" ;
    lv2:symbol "filterGroup" .

<https://suprduprnatural.github.io/supr-pedals/octave>
    a lv2:Plugin , lv2:PitchPlugin ;
    doap:name "SuprOctave" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    lv2:minorVersion 1 ;
    lv2:microVersion 2 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    mod:brand "Supr" ;
    mod:label "SuprOctave" ;
    rdfs:comment "Analog-style octaver in the spirit of the Boss OC-2, tuned for bass guitar. A flip-flop divider makes a one-octave-down voice with envelope-tracked gating. Direct and Oct 1 set the mix. Drive adds rounded, oversampled saturation to the octave voice; High pass and Low pass shape its output. Gate sets the level below which the sub mutes. The direct signal stays clean." ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "direct" ;
        lv2:name "Direct" ;
        pg:group oc:mixGroup ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
        rdfs:comment "Level of the clean (unprocessed) signal." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "oct1" ;
        lv2:name "Oct 1" ;
        pg:group oc:mixGroup ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
        rdfs:comment "Level of the one-octave-down voice." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "tone" ;
        lv2:name "Low pass" ;
        pg:group oc:filterGroup ;
        lv2:default 150.0 ;
        lv2:minimum 150.0 ;
        lv2:maximum 4000.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:hz ;
        rdfs:comment "12 dB/octave low-pass cutoff after the octave drive: low = smooth and synthy, high = more grind. Does not filter the direct signal." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "gate" ;
        lv2:name "Gate" ;
        pg:group oc:subGroup ;
        lv2:default -55.0 ;
        lv2:minimum -80.0 ;
        lv2:maximum -30.0 ;
        units:unit units:db ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value -80.0 ] ;
        rdfs:comment "Input level below which the sub voices mute (prevents warble on decaying notes)." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "drive" ;
        lv2:name "Drive" ;
        pg:group oc:subGroup ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
        rdfs:comment "Rounded saturation on the generated octave, from gentle analogue colour to dense synth-like drive. Uses 2x oversampling and gradual level compensation. Does not drive the direct signal or the pitch detector." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "highpass" ;
        lv2:name "High pass" ;
        pg:group oc:filterGroup ;
        lv2:default 10.0 ;
        lv2:minimum 10.0 ;
        lv2:maximum 1000.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:hz ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 10.0 ] ;
        rdfs:comment "12 dB/octave high-pass cutoff after the octave drive. Minimum is Off. Removes sub-bass or isolates upper octave harmonics without filtering the direct signal." ;
    ] .
