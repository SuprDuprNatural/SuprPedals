<https://suprduprnatural.github.io/supr-pedals/vowel#fonky> a pset:Preset ; lv2:appliesTo <https://suprduprnatural.github.io/supr-pedals/vowel> ; rdfs:label "Fonky Conversation" ;
    lv2:port [ lv2:symbol "vowel_a" ; pset:value 0 ],
    [ lv2:symbol "vowel_b" ; pset:value 2 ],
    [ lv2:symbol "mode" ; pset:value 1 ],
    [ lv2:symbol "position" ; pset:value 0 ],
    [ lv2:symbol "depth" ; pset:value 1 ],
    [ lv2:symbol "rate" ; pset:value 1 ],
    [ lv2:symbol "sensitivity" ; pset:value 6 ],
    [ lv2:symbol "release" ; pset:value 180 ],
    [ lv2:symbol "throat" ; pset:value 0 ],
    [ lv2:symbol "focus" ; pset:value 0.6 ],
    [ lv2:symbol "dry" ; pset:value -7.95880017344 ],
    [ lv2:symbol "wet" ; pset:value 4.08239965312 ],
    [ lv2:symbol "protect" ; pset:value 1 ] .

