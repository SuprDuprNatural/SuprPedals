    [ lv2:symbol "tight" ; pset:value 260 ],
    [ lv2:symbol "bite" ; pset:value 4 ],
    [ lv2:symbol "fizz" ; pset:value 4500 ],
    [ lv2:symbol "level" ; pset:value -4 ],
    [ lv2:symbol "comp" ; pset:value 4 ],
    [ lv2:symbol "gate" ; pset:value -62 ] .

