    [ lv2:symbol "level" ; pset:value -5 ],
    [ lv2:symbol "comp" ; pset:value 3 ],
    [ lv2:symbol "gate" ; pset:value -65 ] .

<https://suprduprnatural.github.io/supr-pedals/forge#cold-iron> a pset:Preset ; lv2:appliesTo <https://suprduprnatural.github.io/supr-pedals/forge> ; rdfs:label "Cold Iron" ;
