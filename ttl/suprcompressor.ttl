@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix param:  <http://lv2plug.in/ns/ext/parameters#> .
@prefix pg:     <http://lv2plug.in/ns/ext/port-groups#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

@prefix comp: <https://suprduprnatural.github.io/supr-pedals/compressor#> .

comp:compressionGroup
    a param:ControlGroup , pg:InputGroup ;
    lv2:name "Compression" ;
    lv2:symbol "compressionGroup" .

comp:outputGroup
    a param:ControlGroup , pg:InputGroup ;
    lv2:name "Output" ;
    lv2:symbol "outputGroup" .

<https://suprduprnatural.github.io/supr-pedals/compressor>
    a lv2:Plugin , lv2:CompressorPlugin ;
    doap:name "SuprCompressor" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    lv2:minorVersion 2 ;
    lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    mod:brand "Supr" ;
    mod:label "SuprCompressor" ;
    rdfs:comment "Clean studio-grade compressor with log-domain envelope smoothing and a soft knee that widens at gentle ratios (opto-style leveling) and tightens toward limiting (FET-style grab). Attack down to 0.1 ms. Sidechain high-pass keeps bass fundamentals from pumping. Blend for parallel compression." ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "threshold" ;
        lv2:name "Threshold" ;
        pg:group comp:compressionGroup ;
        lv2:default -24.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 0.0 ;
        units:unit units:db ;
        rdfs:comment "Level where compression begins." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "ratio" ;
        lv2:name "Ratio" ;
        pg:group comp:compressionGroup ;
        lv2:default 4.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 20.0 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:scalePoint [ rdfs:label "Limit" ; rdf:value 20.0 ] ;
        rdfs:comment "2-3 for gentle leveling, 4-8 for punch, 20 to limit. The knee softens automatically at low ratios." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "attack" ;
        lv2:name "Attack" ;
        pg:group comp:compressionGroup ;
        lv2:default 3.0 ;
        lv2:minimum 0.1 ;
        lv2:maximum 100.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:ms ;
        rdfs:comment "Fast (< 1 ms) clamps pick transients; slower lets them punch through." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "release" ;
        lv2:name "Release" ;
        pg:group comp:compressionGroup ;
        lv2:default 200.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 1500.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:ms ;
        rdfs:comment "How quickly gain recovers after a note." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "schpf" ;
        lv2:name "HP" ;
        pg:group comp:compressionGroup ;
        lv2:default 80.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 300.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:hz ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 20.0 ] ;
        rdfs:comment "Sidechain high-pass filter. It changes what the DETECTOR listens to, not what you hear — the audio is never high-passed. Stops low fundamentals from pumping the compressor. 20 = off." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "makeup" ;
        lv2:name "Makeup" ;
        pg:group comp:outputGroup ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 24.0 ;
        pprops:rangeSteps 9 ;
        units:unit units:db ;
        rdfs:comment "Output gain to compensate for the reduction." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "blend" ;
        lv2:name "Blend" ;
        pg:group comp:outputGroup ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Wet/dry mix for parallel (New York) compression." ;
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 9 ;
        lv2:symbol "gr" ;
        lv2:name "Gain Reduction" ;
        lv2:default 0.0 ;
        lv2:minimum -30.0 ;
        lv2:maximum 0.0 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:db ;
        rdfs:comment "Current gain reduction (shown on the meter)." ;
    ] .
