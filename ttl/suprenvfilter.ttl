@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix param:  <http://lv2plug.in/ns/ext/parameters#> .
@prefix pg:     <http://lv2plug.in/ns/ext/port-groups#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

@prefix ef: <https://suprduprnatural.github.io/supr-pedals/envelope-filter#> .

ef:envelopeGroup
    a param:ControlGroup , pg:InputGroup ;
    lv2:name "Envelope" ;
    lv2:symbol "envelopeGroup" .

ef:filterGroup
    a param:ControlGroup , pg:InputGroup ;
    lv2:name "Filter" ;
    lv2:symbol "filterGroup" .

ef:outputGroup
    a param:ControlGroup , pg:InputGroup ;
    lv2:name "Output" ;
    lv2:symbol "outputGroup" .

<https://suprduprnatural.github.io/supr-pedals/envelope-filter>
    a lv2:Plugin , lv2:FilterPlugin ;
    doap:name "SuprEnvelope" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    lv2:minorVersion 2 ;
    lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    mod:brand "Supr" ;
    mod:label "SuprEnvelope" ;
    rdfs:comment "Classic bass auto-wah: your picking envelope sweeps a resonant filter (low/band/high-pass) up to 8 octaves, upward or downward. A detector high-pass rejects sub-octave energy, and Blend mixes dry back in post-filter so the low end survives." ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "sens" ;
        lv2:name "Sensitivity" ;
        pg:group ef:envelopeGroup ;
        lv2:default 6.0 ;
        lv2:minimum -12.0 ;
        lv2:maximum 24.0 ;
        units:unit units:db ;
        rdfs:comment "How hard your playing drives the sweep. Raise until soft notes still open the filter." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "attack" ;
        lv2:name "Attack" ;
        pg:group ef:envelopeGroup ;
        lv2:default 8.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 200.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:ms ;
        rdfs:comment "How quickly the filter opens after a pluck." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "release" ;
        lv2:name "Release" ;
        pg:group ef:envelopeGroup ;
        lv2:default 150.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 2000.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:ms ;
        rdfs:comment "How quickly the filter closes as the note decays." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "mode" ;
        lv2:name "Mode" ;
        pg:group ef:filterGroup ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Low-pass" ; rdf:value 0 ] ,
                       [ rdfs:label "Band-pass" ; rdf:value 1 ] ,
                       [ rdfs:label "High-pass" ; rdf:value 2 ] ;
        rdfs:comment "Filter type: low-pass is fat, band-pass is the classic quack, high-pass is thin funk." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "dir" ;
        lv2:name "Direction" ;
        pg:group ef:filterGroup ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Up" ; rdf:value 0 ] ,
                       [ rdfs:label "Down" ; rdf:value 1 ] ;
        rdfs:comment "Up: plucks open the filter. Down: plucks close it (reverse quack)." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "cutoff" ;
        lv2:name "Cutoff" ;
        pg:group ef:filterGroup ;
        lv2:default 120.0 ;
        lv2:minimum 40.0 ;
        lv2:maximum 2000.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:hz ;
        rdfs:comment "Resting cutoff (the bottom of the sweep in Up mode)." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "range" ;
        lv2:name "Range" ;
        pg:group ef:filterGroup ;
        lv2:default 3.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 5.0 ;
        rdfs:comment "Sweep width on a compact 0 to 5 panel scale, spanning 0 to 8 octaves above the resting cutoff." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "res" ;
        lv2:name "Resonance" ;
        pg:group ef:filterGroup ;
        lv2:default 0.55 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Filter resonance: the quack knob." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "blend" ;
        lv2:name "Blend" ;
        pg:group ef:outputGroup ;
        lv2:default 0.8 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Wet/dry mix, post-filter. Back it off to keep your low end solid." ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "level" ;
        lv2:name "Level" ;
        pg:group ef:outputGroup ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        rdfs:comment "Output level." ;
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 12 ;
        lv2:symbol "fc" ;
        lv2:name "Fc" ;
        lv2:default 120.0 ;
        lv2:minimum 30.0 ;
        lv2:maximum 8000.0 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:hz ;
        rdfs:comment "Live swept cutoff (drives the response plot)." ;
    ] .
