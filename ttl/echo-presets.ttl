@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://suprduprnatural.github.io/supr-pedals/echo#thickener> a pset:Preset ; lv2:appliesTo <https://suprduprnatural.github.io/supr-pedals/echo> ; rdfs:label "Thickener" ;
    lv2:port [ lv2:symbol "time" ; pset:value 105 ],
    [ lv2:symbol "feedback" ; pset:value 0.18 ],
    [ lv2:symbol "mix" ; pset:value 0.12 ],
    [ lv2:symbol "duck" ; pset:value 0.15 ],
    [ lv2:symbol "tone" ; pset:value 5000 ],
    [ lv2:symbol "lowcut" ; pset:value 160 ],
    [ lv2:symbol "recovery" ; pset:value 200 ],
    [ lv2:symbol "division" ; pset:value 0 ],
    [ lv2:symbol "send" ; pset:value 1 ],
    [ lv2:symbol "hold" ; pset:value 0 ] .

<https://suprduprnatural.github.io/supr-pedals/echo#dotted> a pset:Preset ; lv2:appliesTo <https://suprduprnatural.github.io/supr-pedals/echo> ; rdfs:label "Ducked dotted eighth" ;
    lv2:port [ lv2:symbol "time" ; pset:value 500 ],
    [ lv2:symbol "feedback" ; pset:value 0.45 ],
    [ lv2:symbol "mix" ; pset:value 0.28 ],
    [ lv2:symbol "duck" ; pset:value 0.75 ],
    [ lv2:symbol "tone" ; pset:value 3800 ],
    [ lv2:symbol "lowcut" ; pset:value 180 ],
    [ lv2:symbol "recovery" ; pset:value 300 ],
    [ lv2:symbol "division" ; pset:value 2 ],
    [ lv2:symbol "send" ; pset:value 1 ],
    [ lv2:symbol "hold" ; pset:value 0 ] .

<https://suprduprnatural.github.io/supr-pedals/echo#dub> a pset:Preset ; lv2:appliesTo <https://suprduprnatural.github.io/supr-pedals/echo> ; rdfs:label "Dark quarter throw" ;
    lv2:port [ lv2:symbol "time" ; pset:value 650 ],
    [ lv2:symbol "feedback" ; pset:value 0.72 ],
    [ lv2:symbol "mix" ; pset:value 0.3 ],
    [ lv2:symbol "duck" ; pset:value 0.35 ],
    [ lv2:symbol "tone" ; pset:value 1600 ],
    [ lv2:symbol "lowcut" ; pset:value 240 ],
    [ lv2:symbol "recovery" ; pset:value 450 ],
    [ lv2:symbol "division" ; pset:value 0 ],
    [ lv2:symbol "send" ; pset:value 1 ],
    [ lv2:symbol "hold" ; pset:value 0 ] .
