@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

<https://suprduprnatural.github.io/supr-pedals/vu-meter>
    a lv2:Plugin , lv2:AnalyserPlugin ;
    doap:name "SuprVU" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    lv2:minorVersion 1 ;
    lv2:microVersion 1 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    mod:brand "Supr" ;
    mod:label "SuprVU" ;
    rdfs:comment "Stereo VU meter with classic 300 ms ballistics plus peak indicators. Audio passes through untouched." ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "In L" ;
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "In R" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Out L" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Out R" ;
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 4 ;
        lv2:symbol "vu_l" ;
        lv2:name "VU L" ;
        lv2:default -60.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 6.0 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 5 ;
        lv2:symbol "vu_r" ;
        lv2:name "VU R" ;
        lv2:default -60.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 6.0 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 6 ;
        lv2:symbol "peak_l" ;
        lv2:name "Peak L" ;
        lv2:default -60.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 6.0 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 7 ;
        lv2:symbol "peak_r" ;
        lv2:name "Peak R" ;
        lv2:default -60.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 6.0 ;
        lv2:portProperty pprops:notOnGUI ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "calibration" ;
        lv2:name "Calibration" ;
        lv2:default 0.0 ;
        lv2:minimum -40.0 ;
        lv2:maximum 0.0 ;
        units:unit units:db ;
        rdfs:comment "Reference level: the input level (dBFS) that reads as 0 VU. Studio standards are -18 or -20 dBFS; 0 lines the meter up with digital full scale." ;
    ] .
